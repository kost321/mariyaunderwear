# PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Values must match docker-compose.yml.
DATABASE_URI=postgres://olga:olga@localhost:5432/olga_shop

# Payload secret: used to sign the admin JWT/cookie.
# In production generate a long random string, for example:
#   openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Public site URL (for metadata, links, previews).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Recipients of new-order emails (one address or several separated by commas).
# If unset, the fallback address from the code is used.
ORDER_NOTIFY_EMAIL=
