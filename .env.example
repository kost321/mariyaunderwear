# PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Values must match docker-compose.yml.
DATABASE_URI=postgres://olga:olga@localhost:5432/olga_shop

# Payload secret: used to sign the admin JWT/cookie.
# In production generate a long random string, for example:
#   openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Public site URL (for metadata, links, previews).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Recipients of new-order emails (one address or several separated by commas).
# If unset, the fallback address from the code is used.
ORDER_NOTIFY_EMAIL=

# TurboSMS: SMS to the customer when the order is placed and when the manager enters the TTN.
# Token: TurboSMS dashboard → Шлюз (API) → Настройки API. Sender is the registered alpha name.
# If unset, SMS are simply not sent.
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# Sentry: error reports. If the DSN is unset, nothing is sent.
# DSN: Sentry → Settings → Projects → (project) → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps at build time so reports show readable code.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
