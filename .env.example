# Строка подключения к PostgreSQL.
# Формат: postgres://<user>:<password>@<host>:<port>/<database>
# Значения должны совпадать с docker-compose.yml.
DATABASE_URI=postgres://olga:olga@localhost:5432/olga_shop

# Секрет Payload: используется для подписи JWT/cookie админки.
# В продакшене сгенерируйте длинную случайную строку, например:
#   openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-secret

# Публичный URL сайта (для метаданных, ссылок, превью).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
