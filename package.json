{
  "name": "olga-shop",
  "version": "1.0.0",
  "description": "E-commerce store for a lingerie brand on Next.js 15 + Payload CMS 3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "payload migrate && next start",
    "lint": "next lint",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "graphql": "^16.9.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "next-intl": "^4.14.6",
    "payload": "3.90.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.14.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "undici": "^7.30.0",
    "postcss": "$postcss"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
